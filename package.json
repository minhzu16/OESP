{
  "name": "online-exam",
  "private": true,
  "description": "Online Examination and Result System (NestJS + PostgreSQL + React)",
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @exam/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @exam/api --filter @exam/web dev",
    "dev:worker": "pnpm --filter @exam/api dev:worker",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @exam/api prisma:migrate",
    "db:seed": "pnpm --filter @exam/api prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,css}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0"
}
