NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://exam:exam@localhost:5432/exam?schema=public
# Leave empty to run the expiry sweeper with an in-process timer instead of BullMQ.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
RESULT_HMAC_SECRET=change-me-result-hmac-secret-at-least-32-chars

SUBMISSION_GRACE_SECONDS=10
EXPIRY_SWEEP_INTERVAL_SECONDS=15
CORS_ORIGIN=http://localhost:5173
THROTTLE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info
